<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="950"
        Background="#0B1F33">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#102A43"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="Cyan"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Stay Safe Online"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="
[ CYBER SECURITY SHIELD ACTIVATED ]
"
           Foreground="LightGreen"
           FontSize="14"
           FontFamily="Consolas"
           HorizontalAlignment="Center"
           Margin="0,10,0,0"/>
            </StackPanel>

        </Border>

        <!-- CHAT AREA -->
        <Border Grid.Row="1"
                Background="#16324F"
                CornerRadius="10"
                Padding="10">

            <ScrollViewer Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto">

                <TextBlock Name="ChatDisplay"
           Foreground="LightGreen"
           FontSize="16"
           FontFamily="Consolas"
           TextWrapping="Wrap"
           Margin="5"/>

            </ScrollViewer>

        </Border>

        <!-- INPUT AREA -->
        <Grid Grid.Row="2"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput"
         KeyDown="UserInput_KeyDown"
         Grid.Column="0"
         Height="40"
         FontSize="16"
         Padding="10"
         Background="White"
         Foreground="Black"
         BorderBrush="Cyan"
         BorderThickness="2"
         CaretBrush="Cyan"/>

            <Button x:Name="SendButton"
        Grid.Column="1"
        Content="SEND"
        Margin="10,0,0,0"
        FontWeight="Bold"
        FontSize="16"
        Background="Cyan"
        Foreground="Black"
        Height="40"
        BorderThickness="0"
        Cursor="Hand"
        Click="SendButton_Click"/>

        </Grid>

    </Grid>

</Window>